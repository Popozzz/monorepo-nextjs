{
  "name": "@repo/i18n",
  "version": "1.0.0",
  "description": "Shared internationalization configuration and messages",
  "private": true,
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./routing": {
      "types": "./src/routing.ts",
      "default": "./src/routing.ts"
    },
    "./navigation": {
      "types": "./src/navigation.ts",
      "default": "./src/navigation.ts"
    },
    "./request": {
      "types": "./src/request.ts",
      "default": "./src/request.ts"
    },
    "./messages/*": "./messages/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next-intl": "^4.13.4"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5"
  }
}
